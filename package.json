{
  "name": "ezdocs",
  "version": "0.1.0",
  "private": true,
  "description": "EZ Docs - Reusable documentation generator with YAML frontmatter + Nextra",
  "keywords": ["documentation", "markdown", "nextra", "yaml", "frontmatter"],
  "repository": {
    "type": "git",
    "url": "https://github.com/samuelcolvin/ezdocs.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "clean": "npm run clean --workspaces",
    "dev": "npm run dev --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}